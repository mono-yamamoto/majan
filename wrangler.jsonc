{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majan",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "majan",
      // 2026-08-26 `wrangler d1 create majan --location apac` で発行（プライマリ: APAC）
      "database_id": "1852711d-a80b-469e-a8df-0c71e90dab0f",
    },
  ],
}
